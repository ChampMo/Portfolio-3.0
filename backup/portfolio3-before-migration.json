   "backdropHtml": "<script type=\"application/json\" id=\"signal-theme\">\n{\n  \"dark\": {\n    \"ground\":     \"#08080a\",\n    \"panel\":      \"#121218\",\n    \"panel-2\":    \"#1b1b26\",\n    \"grid\":       \"#282840\",\n    \"ink\":        \"#ecebf7\",\n    \"ink-muted\":  \"#9791b8\",\n    \"signal\":     \"#6b53f5\",\n    \"on-signal\":  \"#ffffff\",\n    \"telemetry\":  \"#5ad1e6\"\n  },\n  \"light\": {\n    \"ground\":     \"#fdf3ea\",\n    \"panel\":      \"#fffaf4\",\n    \"panel-2\":    \"#fbeade\",\n    \"grid\":       \"#f0dbc6\",\n    \"ink\":        \"#33241a\",\n    \"ink-muted\":  \"#8a7159\",\n    \"signal\":     \"#f0873a\",\n    \"on-signal\":  \"#3a2109\",\n    \"telemetry\":  \"#3f7ca8\"\n  }\n}\n</script>\n\n<style>\n  /* Transparent: the panel behind supplies the ground colour from the tokens\n     above, so there is only ever one place the background is decided. No\n     gradients here — the field stays flat and the only thing on it is dots. */\n  html, body { background: transparent; }\n\n  /* Oversized on every side so the drift can never pull an edge into view. */\n  .dots {\n    position: absolute;\n    inset: -60px;\n    background-image: radial-gradient(\n      color-mix(in srgb, var(--ink) 22%, transparent) 1px,\n      transparent 1.1px\n    );\n    background-size: 30px 30px;\n    will-change: transform;\n  }\n</style>\n\n<div class=\"dots\" id=\"dots\"></div>\n\n<script>\n  (function () {\n    var dots = document.getElementById(\"dots\");\n    if (matchMedia(\"(prefers-reduced-motion: reduce)\").matches) return;\n\n    /* The pointer arrives from the parent page. This frame never receives\n       mouse events of its own — it must not intercept clicks meant for the\n       download button — so the coordinates are posted in. */\n    var tx = 0.5, ty = 0.5, x = 0.5, y = 0.5;\n\n    addEventListener(\"message\", function (e) {\n      var p = e.data && e.data.signalPointer;\n      if (!p) return;\n      tx = p.x;\n      ty = p.y;\n    });\n\n    function frame() {\n      /* Eased follow, and inverted: the grid slides away from the cursor\n         rather than with it, which is what reads as depth instead of as the\n         background being dragged around. */\n      x += (tx - x) * 0.04;\n      y += (ty - y) * 0.04;\n\n      dots.style.transform =\n        \"translate(\" +\n        ((0.5 - x) * 26).toFixed(2) + \"px,\" +\n        ((0.5 - y) * 26).toFixed(2) + \"px)\";\n\n      requestAnimationFrame(frame);\n    }\n\n    requestAnimationFrame(frame);\n  })();\n</script>",
   "backdropOpacity": 100
